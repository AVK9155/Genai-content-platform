generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users (demo workspace labeling — no passwords) ───────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles  BrandVoiceProfile[]
  usageLogs UsageLog[]
  history   GenerationHistory[]
}

// ─── Brand Voice Profiles ────────────────────────────────────────────────────
model BrandVoiceProfile {
  id        String   @id @default(uuid())
  userId    String
  name      String
  tone      String   @default("professional")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

// ─── Usage Logs (for Usage Dashboard) ─────────────────────────────────────────
model UsageLog {
  id           String   @id @default(uuid())
  userId       String
  formats      String   @default("[]") // JSON array of format keys
  outputCount  Int      @default(0)
  groundedCount Int     @default(0)
  checkedCount  Int     @default(0)
  sourceChars  Int      @default(0)
  regenerated  Boolean  @default(false)
  time         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Generation History (recent transformations) ──────────────────────────────
model GenerationHistory {
  id        String   @id @default(uuid())
  userId    String
  preview   String   // first ~60 chars of source
  formats   String   @default("[]") // JSON array of format keys
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
