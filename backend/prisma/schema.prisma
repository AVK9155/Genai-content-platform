generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth & Roles ───────────────────────────────────────
// Roles stored as strings: VILLAGER, ASHA_WORKER, PHC_DOCTOR, DISTRICT_OFFICER, STATE_ADMIN

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  name          String
  role          String    @default("VILLAGER")
  language      String    @default("en")
  village       String?
  district      String?
  state         String    @default("Assam")
  latitude      Float?
  longitude     Float?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  waterQualityReports   WaterQualityReport[]
  symptomReports        SymptomReport[]
  crowdsourcedReports   CrowdsourcedReport[]
  assignedCases         CaseVerification[]  @relation("assignee")
  createdCases          CaseVerification[]  @relation("creator")
  assignedTasks         TaskAssignment[]    @relation("taskAssignee")
  createdTasks          TaskAssignment[]    @relation("taskCreator")
  alerts                Alert[]
  auditLogs             AuditLog[]
}

// ─── Water Quality Module ──────────────────────────────
model WaterSource {
  id          String   @id @default(uuid())
  name        String
  type        String
  latitude    Float
  longitude   Float
  village     String
  district    String
  state       String   @default("Assam")
  isContaminated Boolean @default(false)
  lastTested  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reports     WaterQualityReport[]
}

model WaterQualityReport {
  id            String     @id @default(uuid())
  sourceId      String
  userId        String
  testDate      DateTime
  phLevel       Float?
  turbidity     Float?
  tds           Float?
  chlorineResidual Float?
  ecoliPresence Boolean?
  coliformCount Int?
  otherPathogens String?
  notes         String?
  isVerified    Boolean    @default(false)
  enteredBy     String
  kitUsed       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  source        WaterSource  @relation(fields: [sourceId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

// ─── Symptom Reporting Module ──────────────────────────
model SymptomReport {
  id            String     @id @default(uuid())
  userId        String?
  reporterName  String
  reporterPhone String?
  village       String
  district      String
  state         String     @default("Assam")
  latitude      Float?
  longitude     Float?
  symptomType   String
  severity      String     @default("MODERATE")
  onsetDate     DateTime
  ageGroup      String?
  affectedCount Int        @default(1)
  waterSourceUsed String?
  notes         String?
  source        String     @default("MOBILE")
  isVerified    Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User?      @relation(fields: [userId], references: [id])
}

// ─── Crowdsourced Reports ──────────────────────────────
model CrowdsourcedReport {
  id            String     @id @default(uuid())
  userId        String?
  reporterName  String
  category      String
  description   String
  latitude      Float?
  longitude     Float?
  village       String
  district      String
  state         String     @default("Assam")
  photoUrl      String?
  status        String     @default("NEW")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User?      @relation(fields: [userId], references: [id])
}

// ─── Prediction & Alerts ───────────────────────────────
model RiskScore {
  id            String     @id @default(uuid())
  village       String
  district      String
  state         String     @default("Assam")
  latitude      Float?
  longitude     Float?
  riskLevel     String     @default("LOW")
  score         Float
  factors       String     @default("{}")
  calculatedAt  DateTime   @default(now())
  validUntil    DateTime
  createdAt     DateTime   @default(now())
}

model Alert {
  id            String     @id @default(uuid())
  title         String
  message       String
  riskLevel     String
  village       String
  district      String
  state         String    @default("Assam")
  latitude      Float?
  longitude     Float?
  triggerType   String
  isActive      Boolean   @default(true)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  notifications Notification[]
}

// ─── Case Verification & Workflow ──────────────────────
model CaseVerification {
  id            String     @id @default(uuid())
  reportId      String
  reportType    String
  status        String     @default("PENDING")
  assignedTo    String?
  verifiedBy    String?
  verifiedAt    DateTime?
  notes         String?
  actionTaken   String?
  resolvedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignee      User?      @relation("assignee", fields: [assignedTo], references: [id])
  creator       User?      @relation("creator", fields: [verifiedBy], references: [id])
  tasks         TaskAssignment[]
}

model TaskAssignment {
  id            String     @id @default(uuid())
  caseId        String
  assignedTo    String
  assignedBy    String
  taskType      String
  description   String
  priority      String     @default("MEDIUM")
  status        String     @default("PENDING")
  dueDate       DateTime?
  completedAt   DateTime?
  notes         String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  case          CaseVerification @relation(fields: [caseId], references: [id])
  assignee      User             @relation("taskAssignee", fields: [assignedTo], references: [id])
  creator       User             @relation("taskCreator", fields: [assignedBy], references: [id])
}

// ─── Notifications ─────────────────────────────────────
model Notification {
  id            String     @id @default(uuid())
  userId        String?
  title         String
  message       String
  type          String
  channel       String
  isRead        Boolean    @default(false)
  sentAt        DateTime?
  alertId       String?
  createdAt     DateTime   @default(now())
  alert         Alert?     @relation(fields: [alertId], references: [id])
}

// ─── Weather Data ──────────────────────────────────────
model WeatherData {
  id            String     @id @default(uuid())
  district      String
  state         String    @default("Assam")
  date          DateTime
  rainfallMm    Float?
  temperature   Float?
  humidity      Float?
  windSpeed     Float?
  source        String    @default("IMD")
  createdAt     DateTime  @default(now())
}

// ─── Audit Log ─────────────────────────────────────────
model AuditLog {
  id            String     @id @default(uuid())
  userId        String
  action        String
  entity        String
  entityId      String?
  details       String?
  ipAddress     String?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id])
}

// ─── Government Data Integration ───────────────────────
model GovernmentDataImport {
  id            String     @id @default(uuid())
  source        String
  importDate    DateTime   @default(now())
  recordCount   Int
  status        String
  errors        String?
  fileUrl       String?
}

// ─── Settings ──────────────────────────────────────────
model SystemSettings {
  id            String     @id @default(uuid())
  key           String     @unique
  value         String
  description   String?
  updatedAt     DateTime   @updatedAt
}
